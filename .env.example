GROQ_API_KEY=
GOOGLE_API_KEY=

# Optional API settings
AIPlanX_STORE=sqlite
SQLITE_PATH=aiplanx.db
SESSION_DIR=management_sessions
REPORT_PATH=final_report.json
EMPLOYEE_PATH=employees.csv

# --- Auth (Supabase) ---
# Leave AUTH_PROVIDER unset to auto-detect: supabase when the vars below are
# present, otherwise a local development provider (NOT for production).
# AUTH_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional; derived from SUPABASE_URL when omitted.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Local development auth (only when AUTH_PROVIDER is not "supabase").
# The first sign-up becomes the Owner. This provider is NEVER active when
# Supabase is configured.
AUTH_ALLOW_DEV_PROVIDER=true
DEV_AUTH_TOKEN_SECRET=

# --- AI Assistant (Groq) ---
# The AI Assistant uses GROQ_API_KEY_1 specifically; GROQ_API_KEY stays for
# other integrations.
GROQ_API_KEY_1=
GROQ_ASSISTANT_MODEL=openai/gpt-oss-120b
GROQ_INSIGHTS_MODEL=openai/gpt-oss-120b

# --- Email notifications (SMTP) ---
# Unset SMTP_HOST disables delivery and records emails in the outbox table.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AIPlanX <no-reply@aiplanx.local>
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:5173
